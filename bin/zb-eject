#!/usr/bin/env bash
# zb-eject — staged reverse migration: zerobrew (/opt/zerobrew) -> real Homebrew (/opt/homebrew).
#
# Sibling of zb-check. Run the phases IN ORDER; every phase is safe to re-run:
#   plan      read-only: inventory kegs, compute dependency leaves, write a
#             Brewfile, report blockers (running procs, launchd, login shell)
#   install   brew-bundle the generated Brewfile into /opt/homebrew
#             (zerobrew is untouched — both coexist until teardown)
#   flip      AFTER the dotfiles flip commit is applied + re-stowed: rewrite
#             launchd plists, mise reshim, sed tangled emacs init, restart gpg-agent
#   verify    prove nothing resolves through /opt/zerobrew any more
#   teardown  destructive + gated: sudo rm -rf /opt/zerobrew, remove zb binaries
#
# Cross-machine ordering — BOTH rules matter:
#   1. Run `install` BEFORE applying the dotfiles flip commit. Terminals launch
#      tmux by absolute path; flipping configs before homebrew's tmux exists
#      bricks every new terminal window.
#   2. Do NOT push the flip commit until EVERY machine has run `install` —
#      topgrade auto-pulls ~/.dotfiles (stow makes it live instantly), which
#      would apply the flip to an unprepared machine. Commit locally, push last.

set -uo pipefail

P=/opt/zerobrew
HB=/opt/homebrew
STATE=${ZB_EJECT_STATE:-$HOME/.cache/zb-eject}
DOTFILES=${DOTFILES:-$HOME/.dotfiles}
INDEX_URL=https://formulae.brew.sh/api/formula.json

note() { printf '  %s\n' "$*"; }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
die()  { printf 'zb-eject: %s\n' "$*" >&2; exit 1; }

[ "$(uname -s)" = Darwin ] || die "macOS only"

# NOTE: never use bare `ls` here — it may be aliased to a zerobrew eza. Globs only.

zb_procs() { ps axo pid=,command= | grep -F "$P/" | grep -Fv grep || true; }

# zerobrew references in TRACKED dotfiles. Matches functional refs only
# (/opt/zerobrew, .zerobrew, ZEROBREW_) so a "zerobrew" entry in topgrade's
# disable list doesn't trip it. Gitignored files (the tangled emacs init) are
# excluded — flip fixes those itself.
tracked_refs() {
  command -v rg >/dev/null || return 0
  [ -d "$DOTFILES" ] || return 0
  rg -l --hidden -g '!.git' -g '!bin/zb-*' \
     -e '/opt/zerobrew' -e '\.zerobrew' -e 'ZEROBREW_' "$DOTFILES" 2>/dev/null |
    while IFS= read -r f; do
      git -C "$DOTFILES" check-ignore -q "$f" 2>/dev/null || printf '%s\n' "$f"
    done
}

plan() {
  command -v jq >/dev/null || die "jq required (zerobrew still provides it at this stage)"
  mkdir -p "$STATE"
  [ "$(uname -m)" = arm64 ] || note "WARNING: not arm64 — Homebrew prefix would be /usr/local, but this script and the dotfiles flip commit assume $HB"

  hdr "1. zerobrew keg inventory"
  : > "$STATE/kegs.txt"
  for d in "$P"/Cellar/*/; do
    [ -d "$d" ] || continue
    d=${d%/}; printf '%s\n' "${d##*/}"
  done > "$STATE/kegs.txt"
  n=$(wc -l < "$STATE/kegs.txt" | tr -d ' ')
  [ "$n" -gt 0 ] || die "no kegs under $P/Cellar — is zerobrew installed here?"
  note "$n kegs in $P/Cellar"

  hdr "2. homebrew/core formula index"
  if [ -s "$STATE/formula.json" ] && [ -z "$(find "$STATE/formula.json" -mtime +1 2>/dev/null)" ]; then
    note "using cached $STATE/formula.json (<1 day old)"
  else
    note "downloading $INDEX_URL (~30MB)"
    curl -fsSL "$INDEX_URL" -o "$STATE/formula.json" || die "index download failed"
  fi

  hdr "3. dependency leaves (only these get marked 'installed on request')"
  # zerobrew has no explicit-vs-dep tracking, so `zb bundle dump` lists every keg.
  # Installing all of them verbatim would poison brew's installed_on_request
  # metadata. Instead: leaves = kegs that no other installed keg runtime-depends on.
  sort "$STATE/kegs.txt" > "$STATE/kegs.sorted"
  jq -r --rawfile kegs "$STATE/kegs.txt" '
    ($kegs | split("\n") | map(select(length>0))) as $installed
    | map(select(.name as $n | $installed | index($n)))
    | [ .[].dependencies[] ] | unique
    | map(select(. as $d | $installed | index($d)))
    | .[]' "$STATE/formula.json" | sort > "$STATE/deps.txt"
  comm -23 "$STATE/kegs.sorted" "$STATE/deps.txt" > "$STATE/leaves.txt"
  note "$(wc -l < "$STATE/leaves.txt" | tr -d ' ') leaves / $n kegs"

  jq -r '.[].name' "$STATE/formula.json" | sort > "$STATE/core.txt"
  comm -23 "$STATE/kegs.sorted" "$STATE/core.txt" > "$STATE/unknown.txt"
  if [ -s "$STATE/unknown.txt" ]; then
    note "WARNING: kegs not in today's homebrew/core (renamed/removed?) — kept in Brewfile, may fail:"
    sed 's/^/    /' "$STATE/unknown.txt"
  fi
  jq -r --rawfile kegs "$STATE/kegs.txt" '
    ($kegs | split("\n") | map(select(length>0))) as $installed
    | map(select((.name as $n | $installed | index($n)) and (.deprecated or .disabled)))
    | .[] | "\(.name) \(if .disabled then "(DISABLED — will not install)" else "(deprecated)" end): \(.deprecation_reason // .disable_reason // "?")"
    ' "$STATE/formula.json" | while IFS= read -r l; do note "heads-up: $l"; done

  hdr "4. Brewfile -> $STATE/Brewfile"
  { printf '# Generated by zb-eject on %s, %s. Review before `zb-eject install`.\n' \
      "$(hostname -s)" "$(date +%F)"
    printf '# Leaves — installed explicitly:\n'
    sed 's/^/brew "/; s/$/"/' "$STATE/leaves.txt"
    printf '\n# The remaining kegs arrive as dependencies of the above and get marked as\n'
    printf '# such (so `brew autoremove` works). Uncomment any you consider explicitly\n'
    printf '# yours — dual-role tools like go, gnupg, sqlite, bash are deps of other kegs:\n'
    sed 's/^/# brew "/; s/$/"/' "$STATE/deps.txt"
  } > "$STATE/Brewfile"
  note "written — review it, then run: zb-eject install"

  hdr "5. blockers & heads-ups"
  case "$(dscl . -read "/Users/$USER" UserShell 2>/dev/null)" in
    *"$P"*) note "LOGIN SHELL is under $P — 'chsh -s /bin/zsh' before teardown";;
    *)      note "login shell ok (not zerobrew)";;
  esac
  for f in "$HOME"/Library/LaunchAgents/*.plist /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
    [ -e "$f" ] || continue
    if grep -qe "$P" -e '\.zerobrew' "$f" 2>/dev/null; then
      note "launchd plist references zerobrew: $f (flip phase rewrites user agents; system ones need sudo by hand)"
    fi
  done
  procs=$(zb_procs)
  if [ -n "$procs" ]; then
    note "processes currently running zerobrew binaries (restart from homebrew copies before teardown):"
    printf '%s\n' "$procs" | sed 's/^/    /' | cut -c1-140
  fi
  refs=$(tracked_refs)
  if [ -n "$refs" ]; then
    note "dotfiles still reference zerobrew (EXPECTED now; apply the flip commit only AFTER install):"
    printf '%s\n' "$refs" | sed 's/^/    /'
  fi
  note "free space on /opt: $(df -h /opt | awk 'NR==2{print $4}') (homebrew copies need roughly what $P uses now)"
  [ -x "$HB/bin/brew" ] && note "homebrew present at $HB — install phase will re-merge into it" \
                        || note "homebrew NOT installed — install phase will print the bootstrap command"
}

install() {
  [ -s "$STATE/Brewfile" ] || die "no $STATE/Brewfile — run 'zb-eject plan' first"
  if [ ! -x "$HB/bin/brew" ]; then
    note "Homebrew missing — bootstrap it first (interactive, needs sudo):"
    note '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
    exit 1
  fi
  hdr "brew bundle --file=$STATE/Brewfile"
  "$HB/bin/brew" bundle --file="$STATE/Brewfile"
  rc=$?
  hdr "brew bundle check"
  "$HB/bin/brew" bundle check --file="$STATE/Brewfile" | sed 's/^/  /'
  [ $rc -eq 0 ] || die "brew bundle reported failures above — fix and re-run 'zb-eject install' (it is idempotent)"
  hdr "next steps"
  note "1) apply the dotfiles flip commit locally + re-stow: cd $DOTFILES && just install"
  note "   (do NOT push it until EVERY machine has run 'zb-eject install' —"
  note "    topgrade auto-pulls ~/.dotfiles and would brick an unprepared machine)"
  note "2) zb-eject flip"
}

flip() {
  hdr "1. gates"
  [ -x "$HB/bin/brew" ] || die "homebrew missing — run 'zb-eject install' first"
  "$HB/bin/brew" bundle check --file="$STATE/Brewfile" >/dev/null 2>&1 \
    || die "Brewfile not fully installed — run 'zb-eject install' first"
  note "install complete"
  refs=$(tracked_refs)
  if [ -n "$refs" ]; then
    printf '%s\n' "$refs" | sed 's/^/    /'
    die "tracked dotfiles still reference zerobrew — apply the flip commit and re-stow first"
  fi
  note "tracked dotfiles clean"

  hdr "2. launchd user agents"
  mkdir -p "$STATE"
  found=0
  : > "$STATE/launchd-flipped.tmp"
  [ -s "$STATE/launchd-flipped.txt" ] && cat "$STATE/launchd-flipped.txt" >> "$STATE/launchd-flipped.tmp"
  for f in "$HOME"/Library/LaunchAgents/*.plist; do
    [ -e "$f" ] || continue
    grep -qe "$P" -e '\.zerobrew' "$f" 2>/dev/null || continue
    found=1
    label=$(plutil -extract Label raw "$f" 2>/dev/null) || label=$(basename "$f" .plist)
    note "rewriting $f (label: $label)"
    sed -i '' -e "s|$P/prefix/bin|$HB/bin|g" \
              -e "s|$P/bin|$HB/bin|g" \
              -e "s|$HOME/\.zerobrew/bin:||g" \
              -e "s|$P|$HB|g" "$f"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
    printf '%s\t%s\n' "$label" "$f" >> "$STATE/launchd-flipped.tmp"
  done
  sort -u "$STATE/launchd-flipped.tmp" > "$STATE/launchd-flipped.txt"
  rm -f "$STATE/launchd-flipped.tmp"
  # (re)load every agent ever rewritten — retryable across flip runs
  if [ -s "$STATE/launchd-flipped.txt" ]; then
    while IFS=$'\t' read -r label f; do
      [ -e "$f" ] || continue
      if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
        note "loaded   $label"
      elif launchctl bootstrap "gui/$(id -u)" "$f"; then
        note "reloaded $label"
      else
        note "FAILED to load $label — see launchctl error above; re-run flip to retry"
      fi
    done < "$STATE/launchd-flipped.txt"
  elif [ $found -eq 0 ]; then
    note "none reference zerobrew"
  fi

  hdr "3. mise shims"
  # Shims are symlinks baked to the mise binary that last reshimmed — after
  # teardown they'd all dangle. Reshim with the HOMEBREW mise explicitly.
  if [ -x "$HB/bin/mise" ]; then
    "$HB/bin/mise" reshim && note "shims re-pointed at $HB/bin/mise"
  elif [ -d "$HOME/.local/share/mise/shims" ]; then
    note "WARNING: mise shims exist but $HB/bin/mise is missing — they will dangle at teardown"
  else
    note "no mise shims here"
  fi

  hdr "4. generated (gitignored) emacs init"
  # The tangled *-init.el is what emacs actually loads; the flip commit only
  # fixes the .org source. Blanket path swap is safe; re-tangle properly later.
  for el in "$DOTFILES"/.emacs.d/*.el; do
    [ -e "$el" ] || continue
    if grep -qe "$P" -e '\.zerobrew' "$el" 2>/dev/null; then
      sed -i '' -e "s|$HOME/\.zerobrew/bin:||g" -e "s|$P|$HB|g" "$el"
      note "swapped paths in $el (re-tangle from the .org when convenient)"
    fi
  done

  hdr "5. gpg-agent"
  if command -v gpgconf >/dev/null; then
    gpgconf --kill gpg-agent 2>/dev/null && note "gpg-agent restarted — new pinentry path takes effect"
  fi

  hdr "6. long-lived processes holding zerobrew state"
  procs=$(zb_procs)
  if [ -n "$procs" ]; then
    printf '%s\n' "$procs" | sed 's/^/    /' | cut -c1-140
    note "restart manually-started daemons above (e.g. 'herdr server') from their homebrew copies"
  fi
  note "REQUIRED before verify/teardown:"
  note "  - from a NON-tmux terminal: tmux kill-server   (server env holds zerobrew cert/PATH vars"
  note "    and poisons every new pane; terminals relaunch homebrew tmux via the flipped configs)"
  note "  - restart the emacs daemon if running (in-memory load-path/exec-path still point at $P)"
  note "then open a FRESH terminal and run: zb-eject verify"
}

verify() {
  fails=0
  hdr "1. environment of THIS shell (run from a fresh terminal, outside old tmux panes)"
  case ":$PATH:" in
    *:"$P"*) note "FAIL PATH still contains $P"; fails=$((fails+1));;
    *)       note "ok   PATH clean of $P";;
  esac
  for v in ZEROBREW_ROOT ZEROBREW_PREFIX ZEROBREW_DIR ZEROBREW_BIN \
           SSL_CERT_FILE SSL_CERT_DIR CURL_CA_BUNDLE PKG_CONFIG_PATH CPATH LIBRARY_PATH; do
    val=$(printenv "$v" || true)
    case "$val" in
      *zerobrew*) note "FAIL $v=$val"; fails=$((fails+1));;
    esac
  done

  hdr "2. tool resolution (must never be under $P; skips kegs this machine never had)"
  for spec in tmux:tmux nvim:neovim mise:mise git:git gh:gh delta:git-delta \
              watchman:watchman jq:jq node:node gpg:gnupg docker:docker eza:eza \
              weechat:weechat mongosh:mongosh prettierd:prettierd pyright:pyright sqlite3:sqlite; do
    t=${spec%%:*}; keg=${spec##*:}
    grep -qx "$keg" "$STATE/kegs.txt" 2>/dev/null || { note "skip $t (keg '$keg' not on this machine)"; continue; }
    p=$(command -v "$t" 2>/dev/null) || { note "MISSING $t (in Brewfile?)"; fails=$((fails+1)); continue; }
    case "$p" in
      "$P"/*) note "FAIL $t -> $p"; fails=$((fails+1));;
      *)      note "ok   $t -> $p";;
    esac
  done

  hdr "3. runtime smoke ('Library not loaded' = real fault)"
  TO=$(command -v timeout || command -v gtimeout || true)
  [ -n "$TO" ] || note "note: no timeout/gtimeout on PATH — smoke tests run unguarded"
  for t in tmux nvim git jq gh delta eza watchman weechat sqlite3 mongosh prettierd pyright; do
    command -v "$t" >/dev/null 2>&1 || continue
    if [ -n "$TO" ]; then
      o=$("$TO" 20 "$t" --version 2>&1 | head -1)
    else
      o=$("$t" --version 2>&1 | head -1)
    fi
    case "$o" in
      *"Library not loaded"*|*dyld*|*"command not found"*)
        note "BROKEN $t :: $(printf '%s' "$o" | cut -c1-110)"; fails=$((fails+1));;
      *) note "ok   $t";;
    esac
  done

  hdr "4. TLS trust (uses this shell's cert env)"
  if curl -fsS -o /dev/null --max-time 15 https://formulae.brew.sh; then
    note "ok   https reachable"
  else
    note "FAIL curl https — SSL_CERT_FILE/CURL_CA_BUNDLE likely still point into $P"
    fails=$((fails+1))
  fi

  hdr "5. configs, services & long-lived state"
  pin=$(awk '/^pinentry-program/{print $2}' "$HOME/.gnupg/gpg-agent.conf" 2>/dev/null)
  if [ -n "$pin" ] && [ ! -x "$pin" ]; then
    note "FAIL gpg-agent pinentry missing: $pin"; fails=$((fails+1))
  else
    note "ok   gpg pinentry ${pin:-'(none configured)'}"
  fi
  cfg=$(git config --list 2>/dev/null || true)
  case "$cfg" in
    *"$P"*) note "FAIL git config still references $P"; fails=$((fails+1));;
    *)      note "ok   git config clean";;
  esac
  for f in "$HOME"/Library/LaunchAgents/*.plist /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
    [ -e "$f" ] || continue
    if grep -qe "$P" -e '\.zerobrew' "$f" 2>/dev/null; then
      note "FAIL launchd plist still references zerobrew: $f"; fails=$((fails+1))
    fi
  done
  if [ -s "$STATE/launchd-flipped.txt" ]; then
    while IFS=$'\t' read -r label f; do
      if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
        note "ok   agent loaded: $label"
      else
        note "FAIL agent not loaded: $label (re-run flip)"; fails=$((fails+1))
      fi
    done < "$STATE/launchd-flipped.txt"
  fi
  for el in "$DOTFILES"/.emacs.d/*.el; do
    [ -e "$el" ] || continue
    if grep -qe "$P" -e '\.zerobrew' "$el" 2>/dev/null; then
      note "FAIL emacs init still references zerobrew: $el (run flip)"; fails=$((fails+1))
    fi
  done
  shims="$HOME/.local/share/mise/shims"
  if [ -d "$shims" ]; then
    # buffer, don't pipe into grep -q: early-exit + pipefail turns a hit into rc 141
    shimtargets=$(readlink "$shims"/* 2>/dev/null || true)
    case "$shimtargets" in
      *"$P"*) note "FAIL mise shims point into $P — run: $HB/bin/mise reshim"; fails=$((fails+1));;
      *)      note "ok   mise shims clean";;
    esac
  fi
  tenv=$(tmux show-environment -g 2>/dev/null || true)
  if [ -n "$tenv" ]; then
    case "$tenv" in
      *zerobrew*) note "FAIL tmux server env holds zerobrew vars — from a NON-tmux terminal: tmux kill-server"
                  fails=$((fails+1));;
      *)          note "ok   tmux server env clean";;
    esac
  else
    note "ok   no tmux server running"
  fi
  if command -v emacsclient >/dev/null 2>&1; then
    ed=$(emacsclient -e '(if (or (string-match-p "zerobrew" (or (getenv "PATH") "")) (seq-some (lambda (p) (string-match-p "zerobrew" p)) load-path)) "poisoned" "clean")' 2>/dev/null | tr -d '"')
    case "$ed" in
      poisoned) note "FAIL emacs daemon holds zerobrew paths in memory — save buffers, restart it"; fails=$((fails+1));;
      clean)    note "ok   emacs daemon clean";;
      *)        note "ok   no emacs daemon reachable";;
    esac
  fi

  hdr "6. processes still on zerobrew binaries (informational)"
  procs=$(zb_procs)
  if [ -n "$procs" ]; then
    printf '%s\n' "$procs" | sed 's/^/    /' | cut -c1-140
    note "anything above dies or misbehaves at teardown — restart what matters first"
  else
    note "none"
  fi

  if [ $fails -eq 0 ]; then
    printf '\n\033[32mREADY for teardown.\033[0m  Run: zb-eject teardown\n'
    return 0
  fi
  printf '\n\033[31m%d check(s) failed\033[0m — fix before teardown.\n' "$fails"
  return 1
}

teardown() {
  if [ "${FORCE:-0}" != 1 ]; then
    verify || die "verify failed — not tearing down (FORCE=1 zb-eject teardown to override)"
  fi
  hdr "teardown"
  note "removes: $P, ~/.local/bin/zb, ~/.local/bin/zbx, ~/.zerobrew"
  note "WARNING: any shell/pane opened BEFORE the flip still exports zerobrew cert/PATH"
  note "vars — TLS and mise will mysteriously fail there. Restart long-lived sessions"
  note "(old tmux panes, SSM tunnels, editors) promptly after this."
  printf '  type YES to proceed: '
  read -r ans
  [ "$ans" = YES ] || die "aborted"
  sudo rm -rf "$P" || die "sudo rm -rf $P failed"
  rm -f "$HOME/.local/bin/zb" "$HOME/.local/bin/zbx"
  rm -rf "$HOME/.zerobrew"
  hash -r 2>/dev/null || true
  printf '\n\033[32mzerobrew removed.\033[0m\n'
  note "leftovers to retire once ALL machines are migrated:"
  note "  git rm bin/zb-check bin/zb-eject   (both obsolete; push the flip commit if not yet pushed)"
  note "  rm -rf $STATE"
  note "  prune the zerobrew bug notes from Claude's memory (MEMORY.md + zerobrew-*.md)"
  note "  brew doctor   # sanity-check the merged homebrew install"
}

usage() {
  sed -n '2,/^$/{/^#/s/^# \{0,1\}//p;}' "$0"
}

case "${1:-}" in
  plan|install|flip|verify|teardown) "$1" ;;
  *) usage; exit 1 ;;
esac
