# -*- mode: bash-ts; -*-

# ~/.zshrc-work

# Set Python interpreter for Google CLI including gsutil.
export CLOUDSDK_PYTHON=/Users/ross.timson/.local/bin/python

# The next line enables shell command completion for gcloud.
if [ -f '/opt/homebrew/share/zsh/site-functions/_google_cloud_sdk' ]; then . '/opt/homebrew/share/zsh/site-functions/_google_cloud_sdk'; fi

# Terragrunt Provider Cache
export TG_PROVIDER_CACHE=1
export TG_PROVIDER_CACHE_DIR="$HOME/.terraform.d/plugin-cache"

# Disable the millions of org-wide MCPs as I don't need most of em
export ENABLE_CLAUDEAI_MCP_SERVERS=false


# Resolve AWS CLI profile for SSM/EC2 helpers. Prefer explicit --profile, then
# AWS_SSM_PROFILE (tool-specific), then standard AWS_PROFILE.
__causaly_ssm_profile () {
    local p="${AWS_SSM_PROFILE:-${AWS_PROFILE:-}}"
    if [[ -z "$p" ]]; then
        echo "ssm-port-forward: set AWS_PROFILE (or AWS_SSM_PROFILE), or pass --profile <name>" >&2
        return 1
    fi
    echo "$p"
}

# Usage:
#   ssm-port-forward [--profile <aws-profile>] [--remote-port <n>] [--local-port <n>] <tag:Name> [remote_port [local_port]]
# With no --profile, uses AWS_SSM_PROFILE or AWS_PROFILE (same order as __causaly_ssm_profile).
# Default remote (tinyproxy) / local (your laptop): 8888 / 8855 — override with flags, env, or positionals.
#   SSM_PORT_FORWARD_REMOTE, SSM_PORT_FORWARD_LOCAL  (defaults before flags/positionals)
# Each run sets SSM --reason to rtproxy-<uuidgen> unless SSM_PORT_FORWARD_REASON is already set
# (export a fixed value if you need a stable tag for describe-sessions / scripts).
# Concurrent clusters: give each forward a different local port, e.g.
#   AWS_PROFILE=csly-dev-pvd2-administrator ssm-port-forward --local-port 8855 csly-dev-pvd2-tinyproxy &
#   AWS_PROFILE=csly-dmo-dem1-administrator ssm-port-forward --local-port 8866 csly-dmo-dem1-tinyproxy &
#   # or: SSM_PORT_FORWARD_LOCAL=8877 ssm-port-forward --profile … my-tinyproxy &
ssm-port-forward () {
    local PROFILE VM_NAME REMOTE_PORT LOCAL_PORT INSTANCE_ID SESSION_REASON
    REMOTE_PORT="${SSM_PORT_FORWARD_REMOTE:-8888}"
    LOCAL_PORT="${SSM_PORT_FORWARD_LOCAL:-8855}"

    if [[ -n "${SSM_PORT_FORWARD_REASON:-}" ]]; then
        SESSION_REASON=$SSM_PORT_FORWARD_REASON
    else
        local u
        u=$(uuidgen | tr '[:upper:]' '[:lower:]')
        if [[ -z "$u" ]]; then
            echo "ssm-port-forward: uuidgen failed (need a session reason)" >&2
            return 1
        fi
        SESSION_REASON="rtproxy-$u"
    fi

    while [[ "$1" == -* ]]; do
        case "$1" in
            --profile)
                [[ -n "${2:-}" ]] || { echo "ssm-port-forward: --profile needs a value" >&2; return 1; }
                PROFILE=$2
                shift 2
                ;;
            --remote-port|--remote)
                [[ -n "${2:-}" ]] || { echo "ssm-port-forward: --remote-port needs a value" >&2; return 1; }
                REMOTE_PORT=$2
                shift 2
                ;;
            --local-port|--local)
                [[ -n "${2:-}" ]] || { echo "ssm-port-forward: --local-port needs a value" >&2; return 1; }
                LOCAL_PORT=$2
                shift 2
                ;;
            *)
                echo "ssm-port-forward: unknown option: $1" >&2
                return 1
                ;;
        esac
    done

    VM_NAME=$1
    [[ -n "$VM_NAME" ]] || { echo "ssm-port-forward: missing instance tag Name (see ~/.zshrc-work)" >&2; return 1; }
    shift || true

    if [[ -n "${1:-}" ]]; then REMOTE_PORT=$1; shift; fi
    if [[ -n "${1:-}" ]]; then LOCAL_PORT=$1; shift; fi

    if [[ -z "${PROFILE:-}" ]]; then
        PROFILE=$(__causaly_ssm_profile) || return 1
    fi

    INSTANCE_ID=$(aws ec2 describe-instances \
        --profile "$PROFILE" \
        --filters "Name=tag:Name,Values=$VM_NAME" \
                  "Name=instance-state-name,Values=running" \
        --query "Reservations[0].Instances[0].InstanceId" \
        --output text)

    if [[ -z "$INSTANCE_ID" || "$INSTANCE_ID" == "None" ]]; then
        echo "ssm-port-forward: no running instance with Name=$VM_NAME (profile=$PROFILE)" >&2
        return 1
    fi

    echo "ssm-port-forward: $VM_NAME ($PROFILE) 127.0.0.1:${LOCAL_PORT} -> instance:${REMOTE_PORT} ($INSTANCE_ID)" >&2

    aws ssm start-session \
        --profile "$PROFILE" \
        --target "$INSTANCE_ID" \
        --reason "$SESSION_REASON" \
        --document-name AWS-StartPortForwardingSession \
        --parameters "{\"portNumber\":[\"$REMOTE_PORT\"], \"localPortNumber\":[\"$LOCAL_PORT\"]}" &
}

# Preset tinyproxy forwards (local ports differ so you can run several at once).
alias aws-csly-dev-pvd2-tinyproxy='ssm-port-forward --profile csly-dev-pvd2-administrator --remote-port 8888 --local-port 8855 csly-dev-pvd2-tinyproxy'
alias aws-csly-dmo-dem1-tinyproxy='ssm-port-forward --profile csly-dmo-dem1-administrator --remote-port 8888 --local-port 8866 csly-dmo-dem1-tinyproxy'

