# General Settings
# -----------------------------------------------------------------------------

font-family = "GohuFont 14 Nerd Font"
font-size = 14
# Disable antialiasing for GohuFont and also disable the OS's antialiasing with:
#     defaults write com.mitchellh.ghostty AppleFontSmoothing -int 0
freetype-load-flags = monochrome
auto-update = download
command = /opt/homebrew/bin/tmux new-session -A -s rt
confirm-close-surface = false
macos-option-as-alt = true
macos-titlebar-style = hidden
maximize = true
minimum-contrast = 3
theme = light:dawnfox,dark:terafox
window-inherit-working-directory = true
window-padding-x = 12
window-theme = auto
working-directory = home


# Keybindings
# -----------------------------------------------------------------------------

# Cut 'n' Paste
keybind = ctrl+y=paste_from_clipboard
