# -*- mode: conf-unix-mode; indent-tabs-mode: t; tab-width: 4; -*-

[init]
	defaultBranch = main

[user]
	name = Ross Timson
	email = me@rosstimson.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFLG4jA01/e+2YsYsRVkwsimmDKwCu6oZUTGo79sSZm5

# Conditionally set work email when in work dir.
[includeIf "gitdir:~/code/work/"]
	path = ~/.config/git/config-work

[github]
	user = rosstimson

[core]
	autocrlf = input
	#editor = emacsclient -c -a=
	editor = nvim

# For use with gh
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

# https://github.com/dandavison/delta
[delta]
	line-numbers = true
	navigate = true

[branch]
	autoSetupMerge = simple

[fetch]
	prune = true

[pull]
	ff = only

[push]
	default = simple
	followTags = true
	autoSetupRemote = true

[remote]
	pushdefault = origin

[commit]
	gpgsign = true

[diff]
	tool = Kaleidoscope

[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

# Terminal structural diff. Invoked on demand via the `dft` alias; Kaleidoscope
# stays the default graphical difftool (git dt / git difftool). Args use the
# GIT_EXTERNAL_DIFF form so difft sees the real path ($MERGED) for language
# detection. --color always because difft drops color when piped to a pager.
[difftool "difftastic"]
	cmd = difft --color always \"$MERGED\" \"$LOCAL\" abcdef1 100644 \"$REMOTE\" abcdef2 100644

[difftool]
	prompt = false

[merge]
	conflictstyle = diff3
	tool = Kaleidoscope

[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true

[mergetool]
	prompt = false

[rerere]
	enabled = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = /Users/ross.timson/.config/git/allowed_signers

[sendemail]
	sendmailCmd = msmtp

[alias]
	a = add
	b = branch
	bl = blame
	c = commit -v
	cl = clone
	co = checkout
	cp= cherry-pick
	d = diff
	ds = diff --staged
	dt = difftool
	# difftastic in the terminal; pager.difftool scoped to just this alias so
	# `git dt` (Kaleidoscope) is unaffected.
	dft = -c pager.difftool=true difftool -t difftastic
	f = fetch
	i = init
	l = pull
	last = log -1 HEAD
	lg = !"git lg1"
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(blue)%h%C(reset) - %C(green)(%ar)%C(reset) %s %C(magenta)- %an%C(reset)%C(yellow)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(blue)%h%C(reset) - %C(cyan)%aD%C(reset) %C(green)(%ar)%C(reset)%C(yellow)%d%C(reset)%n''         %s %C(magenta)- %an%C(reset)' --all
	lo = log --oneline
	lr = pull --rebase
	m = merge
	mt = mergetool --no-prompt
	p = push
	r = remote
	rb = rebase
	re = restore
	res = restore --staged
	root = rev-parse --show-toplevel
	rs = reset
	rv = revert
	s = status
	sh = show
	sm = switch main
	st = stash
	stash-all = stash save --include-untracked
	std = stash show -p
	sw = switch
	t = tag
	undo = reset --soft HEAD^
	unstage = reset HEAD --
