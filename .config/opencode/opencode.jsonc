{
    "$schema": "https://opencode.ai/config.json",
    "theme": "opencode",
    "model": "zai-coding-plan/glm-4.7",
    "small_model": "zai-coding-plan/glm-4.7-flash",
    "autoupdate": true,
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp/oauth",
            "enabled": true
        }
    },
    "permission": {
        "read": {
            "~/.config/opencode/get-shit-done/*": "allow"
        },
        "external_directory": {
            "~/.config/opencode/get-shit-done/*": "allow"
        }
    }
}
