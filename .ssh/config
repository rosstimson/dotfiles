Include ~/.ssh/config.d/*
Include ~/.colima/ssh_config


AddKeysToAgent yes

Host *
  IdentityAgent ~/.1password/agent.sock
  #IdentitiesOnly=yes

Host pihole
  HostName 192.168.0.2
  User rosstimson


# Multiple Github accounts
# -----------------------------------------------------------------------------
# Work is default (for Terraform, shared repos, etc.)
# Personal uses github-personal alias

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/causaly_id_ed25519.pub
    IdentitiesOnly yes

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/personal_id_ed25519.pub
    IdentitiesOnly yes
