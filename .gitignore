# Ignore everything in ~/.ssh except config and public keys to avoid private
# keys ending up in git repo.
.ssh/*
!.ssh/config
!.ssh/personal_id_ed25519.pub
!.ssh/causaly_id_ed25519.pub


# Ignore transient junk
# ------------------------------------------------------------------

.agent-shell/

.cargo/*
!.cargo/config

.config/mole/*
!.config/mole/whitelist_optimize

.config/argocd/
.config/carapace/
.config/configstore/
.config/cursor/
.config/exercism/
.config/helm/
.config/gcloud/
.config/gh/
.config/github-copilot/
# Jujutsu: keep config.toml, ignore local repo metadata cache
.config/jj/repos/
.config/hcp
.config/helix/runtime/
# Herdr: keep config.toml, ignore logs/sockets/session state
.config/herdr/*
!.config/herdr/config.toml
.config/mozilla/
.config/op/
.config/opencode/cache/
.config/opencode/plugins/

# Zed Editor (https://zed.dev)
# Ignore all except the config files
.config/zed/*
!.config/zed/keymap.json
!.config/zed/settings.json


.emacs.d/*.sqlite
.emacs.d/.bookmarks.el
.emacs.d/eln-cache
.emacs.d/forge-database.sqlite
.emacs.d/history
.emacs.d/projects
.emacs.d/spell-fu
.emacs.d/straight/
.emacs.d/transient/
.emacs.d/url/

.gnupg/*
!.gnupg/gpg-agent.conf
!.gnupg/gpg.conf
!.gnupg/scdaemon.conf

.local/*
!.local/applications
!.local/rofi/themes

.vim/pack/minpac/start

# ZSH byte compiled
*.zwc


# Potentially Sensitive
# ------------------------------------------------------------------

.config/causaly/
.config/context7/
