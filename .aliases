# Common shell aliases that I source in ~/.profile

# Use 'doas' rather than 'sudo' when available
if command -v doas > /dev/null; then
   alias _='doas '
else
   alias _='sudo '
fi


# General
# ----------------------------------------------------------------------------

# `//` is not a valid alias in BASH so check we're in ZSH and if not
# set a more compatible alternative 'of `gr`.
if [[ -n "$ZSH_VERSION" ]]; then
    alias //='cd $(git root)'
else
    alias gr='cd $(git root)'
fi

alias -- -='cd -'
alias ....="cd ../../.."
alias ...="cd ../.."
alias ..="cd .."
alias cdtmp='cd $(mktemp --directory -t rosstimson-tmp)'
alias cg='cargo'
alias exc='exercism'
alias g='git'
alias gc='gcloud'
alias h='fc -li 1'
alias ip='ip --color'
alias ipb='ip --color --brief'
alias k='kubectl'
alias kn='kubens'
alias kx='kubectx'
alias l='eza -agl --git'
alias less='less -i'
alias lg='lazygit'
alias ll='eza -a --oneline'
alias ls='eza'
alias lt='eza -T'
alias oc='opencode'
alias pwup='cd $HOME/.password-store && git push -u origin master && cd -'
alias ru='rustup'
alias rup='rustup update'
alias sc='shellcheck'
alias serve='python -m http.server 8080'
alias showpath="echo \$PATH | tr -s ':' '\n'"
alias t='tmux new-session -A -s rt'
alias vi='nvim'
alias vim='nvim'
alias ~='cd $HOME'

# Cleans up git branches that are no longer on the remote, quick and easy way
# to get rid of local branches once PRs are merged.
alias gbcleanup='git fetch -p ; git branch -r | awk '\''{print $1}'\'' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '\''{print $1}'\'' | xargs git branch -d'



# ============================================================================
# Tool Specific
# ============================================================================

# Atmos
# ----------------------------------------------------------------------------

alias a='atmos'


# Bundler
# ----------------------------------------------------------------------------
alias bi='bundle install'
alias be='bundle exec'


# Docker
# ----------------------------------------------------------------------------
alias d='docker'
alias da='docker attach'
alias db='docker build'
alias dc='docker commit'                        # Clobbers GNU dc calculator tool
alias dclean='docker rmi -f $(docker images -q -a -f dangling=true)' # Removes all untagged images
alias ddr='docker run -d'
alias de='docker exec -t -i'
alias di='docker images'
alias dl='docker pull'
alias dlg='docker logs'
alias dm='docker-machine'
alias dp='docker push'
alias dps='docker ps'
alias dr='docker run'
alias dri='docker run -it --rm'
alias drm='docker rm'
alias drma='docker rm $(docker ps -a -q)'       # Remove all containers
alias drmi='docker rmi'
alias ds='docker stop'
alias dsa='docker stop $(docker ps -a -q)'      # Stop all containers
alias dt='docker tag'


# Fun / Silly
# ----------------------------------------------------------------------------
alias matrix='while :; do echo $LINES $COLUMNS $(( $RANDOM % $COLUMNS)) $(printf "\U$(($RANDOM % 500))");sleep 0.05;done|awk '"'"'{a[$3]=0;for (x in a){o=a[x];a[x]=a[x]+1;printf "\033[%s;%sH\033[2;32m%s",o,x,$4;printf "\033[%s;%sH\033[1;37m%s\033[0;0H",a[x],x,$4;if (a[x]>=$1){a[x]=0;}}}'"'"''


# Kubernetes
# ----------------------------------------------------------------------------
alias k8s-start='colima start --runtime containerd --with-kubernetes'
alias k8s-stop='colima stop'


# Pulumi
# ----------------------------------------------------------------------------
alias p='pulumi'
alias pu='pulumi up'


# Rails
# ----------------------------------------------------------------------------
alias r='rails'
alias rcon='rails console'
alias rmig='rails db:migrate'
alias rgen='rails generate'


# Rclone
# ----------------------------------------------------------------------------
alias rclone='rclone --password-command "op read op://personal/Rclone/password"'


# Terraform
# ----------------------------------------------------------------------------
alias tf='terraform'
alias tfa='terraform apply'
alias tfi='terraform init'
alias tfl='tflint --config=$(git rev-parse --show-toplevel)/.tflint.hcl'
alias tfp='terraform plan'
alias tfs='terraform state'
alias tfv='terraform validate'
alias tfw='terraform workspace'


# Terragrunt
# ----------------------------------------------------------------------------
alias tg='terragrunt'
alias tga='terragrunt apply'
alias tgaa='terragrunt run --all apply'
alias tgda='terragrunt run --all destroy'
alias tgi='terragrunt init'
alias tgia='terragrunt run --all init'
alias tgp='terragrunt plan'
alias tgpa='terragrunt run --all plan'
alias tgs='terragrunt state'
alias tgv='terragrunt validate'


# Work
# ----------------------------------------------------------------------------
alias cloudauth='gcloud auth login && gcloud auth application-default login && aws sso login --sso-session causaly'
# Kill ONLY jump-host tunnel processes (not every aws/gcloud process):
#   AWS-StartPortForwardingSession  -> aws ssm port-forwards (aws cli + session-manager-plugin)
#   [:=]localhost:8888              -> gcp/azure ssh -L forwards to a tinyproxy (8855/8866/8877/8888)
#   start-iap-tunnel                -> gcloud IAP tunnel helpers (incl. ProxyCommand children)
# SIGTERM is enough for all of these; rerun with pkill -9 if one ever wedges.
alias kill-tunnels='pkill -f "AWS-StartPortForwardingSession|[:=]localhost:8888|start-iap-tunnel"; sleep 1; ps -ef | rg "[A]WS-StartPortForwardingSession|[:=]localhost:8888|[s]tart-iap-tunnel" || echo "no tunnel processes remain"'
alias unaws='unset $(env | grep "^AWS_" | egrep -o "^[^=]+")'

alias gcp-tinyproxy='gcloud beta compute ssh csly-prd-mgt1-tp01-vm \
                         --project csly-prd-mgt1-tp01 \
                         --zone us-east1-b \
                         -- -L 8888:localhost:8888 -N -q -f'

# Azure jump host tinyproxy (csly-mgt-tp01-vm, proxy listens on 8888).
# Local 8877 -> tp01 tinyproxy:8888; kubeconfig aks01 cluster uses
# proxy-url http://localhost:8877. kill-tunnels catches it.
# NB: backgrounded with & (not ssh -f) — az ssh wraps the ssh process to
# manage its ephemeral Entra cert and never exits if ssh forks itself.
alias azure-tinyproxy='az ssh vm \
                           --subscription 035aac57-d2e0-464c-9b59-b38be09ad681 \
                           --resource-group csly-mgt-tp01-rg \
                           --name csly-mgt-tp01-vm \
                           -- -L 8877:localhost:8888 -N -q &'

